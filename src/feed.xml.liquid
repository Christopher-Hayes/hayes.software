---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name }}</title>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
    <description>Personal site of creative frontend developer, Chris Hayes.</description>
    <language>en</language>
    {%- for post in collections.blog limit:30 %}
    <item>
      <title>{{ post.data.title | escape }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid>{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | date: "%a, %d %b %Y 00:00:00 GMT" }}</pubDate>
      {%- if post.data.meta.desc %}
      <description>{{ post.data.meta.desc | escape }}</description>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
